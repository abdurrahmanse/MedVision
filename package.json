{
  "name": "AI-Data-Analyst",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types"
  },
  "devDependencies": {
    "prettier": "^3.7.4",
    "turbo": "^2.10.11",
    "typescript": "7.0.2"
  },
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=18"
  },
  "pnpm": {
    "overrides": {
      "tmp@<=0.2.3": ">=0.2.4"
    },
    "peerDependencyRules": {
      "allowedVersions": {
        "storybook": ">=8",
        "eslint": ">=9",
        "typescript": ">=4"
      }
    }
  }
}

